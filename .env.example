# Copy this file to ".env" and fill in your key from https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional: extra Groq keys. If a key is rejected, rate-limited or the service
# is briefly down, the app retries the same request with the next key.
# GROQ_API_KEY_2=your_second_key_here
# GROQ_API_KEY_3=your_third_key_here
# Or list several keys in one variable:
# GROQ_API_KEYS=key_one,key_two,key_three

# Optional: override the model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: NASA AppEEARS satellite point samples (MODIS NDVI, land-surface
# temperature, SMAP soil moisture). Create a free Earthdata Login account at
# https://urs.earthdata.nasa.gov and add the same username/password here.
# Without these the app still works and reports satellite coverage as a gap.
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
